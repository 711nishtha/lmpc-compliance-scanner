# Copy to .env and fill in. NEVER commit a real .env — see docs/DEPLOYMENT.md.

APP_ENV=development

# Mandatory when APP_ENV=production (the app refuses to start without it).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# Defaults to a local SQLite file; set for Postgres in production.
# DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname

STORAGE_DIR=backend/data/uploads

# Comma-separated. Never "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MAX_UPLOAD_BYTES=12582912
SCAN_RATE_LIMIT=12
SCAN_RATE_WINDOW_SECONDS=60

# Defaults false in production. Set true only deliberately.
# ENABLE_DOCS=false
