# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---- Secrets: never commit. .env.example IS committed as the template. ----
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ---- Local dev database + generated artifacts ----
# Holds the SQLite dev DB, uploaded scan images and generated PDF/DOCX reports.
# All regenerated by scripts/seed_demo.py — never committed.
# Matched at ANY depth: a cwd-relative STORAGE_DIR default once produced a nested
# backend/backend/data/ tree that the root-anchored pattern missed, staging ~74 MB.
**/data/
backend/data/
*.db
*.sqlite
*.sqlite3

# ---- Node / frontend build output ----
node_modules/
frontend/dist/
frontend/node_modules/
.vite/

# ---- QA artifacts ----
# Raw Playwright recordings are large and regenerable. The ENCODED videos in
# frontend/public/demo/ ARE committed — the deployed hero and "See it scan"
# section need them at runtime.
frontend/qa/recordings/
frontend/qa/*_state.json

# ---- Scratch / logs / OS ----
scratchpad/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Local-only deployment operations material ----
# The public repo is the source code plus the documentation needed to understand and
# run the tool (README.md, docs/). Deployment *operations* material — click-by-click
# platform setup, gathered per-service configs, account-level steps — is internal
# working reference and is deliberately NOT part of the public project.
deploy_ready/

# Generated by `git archive HEAD` as a local reference export of this very repo.
github_repo/
